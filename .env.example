#*************#
#** DISCORD **#
#*************#

# Discord 'App Token' and 'Client ID'
# https://discord.com/developers/applications
TOKEN=
CLIENT_ID=

# The 'Role ID' -> The role to give once the repo has been starred
# The 'Server ID' -> The server where the bot is going to be used
# The 'Channel ID' -> The channel where the bot is going to post
# These must be numeric IDs (enable Developer Mode in Discord, then "Copy ID").
ROLE_ID=
GUILD_ID=
CHANNEL_ID=

# Automatically check if the verified users removed their star on the repo,
# then remove their role on discord and update their status in the database.
# The delay is in seconds and is clamped to a 5 minute minimum.
# examples: 300 = 5 minutes, 3600 = 1 hour, 86400 = 1 day, 604800 = 1 week
AUTOMATIC_CHECK=true
AUTOMATIC_CHECK_DELAY=3600

# The bot applies the role changes the GitHub star webhook recorded. The
# webhook reaches the server process, which writes what changed to the
# database; this is how often the bot picks that up and moves the role.
# The queue is indexed so that a poll with nothing waiting reads nothing,
# which is why this interval is seconds rather than hours. It is clamped to
# a 5 second minimum.
# Turn it off if you have not configured the webhook: there is then nothing
# to pick up. It is independent of AUTOMATIC_CHECK above, so you can run
# either, both, or neither.
ROLE_SYNC_ENABLED=true
ROLE_SYNC_INTERVAL=30

# Custom "Useful links" command - OPTIONAL.
# Leave COMMAND_NAME empty to skip registering this command entirely.
# The name only supports lowercase letters.
# Only buttons with both a label (BTNx) and a URL (URLx) are shown.
COMMAND_NAME=hyperlinks
COMMAND_DESCRIPTION=Useful Links
COMMAND_EXTENDED_DESCRIPTION=- 🌐 Quick access to **GitHub**, **Discord**, **YouTube** and **Reddit**

BTN1=💻GitHub
URL1=https://github.com/

BTN2=💬Discord
URL2=https://discord.com/

BTN3=📺Youtube
URL3=https://youtube.com/

BTN4=📝Reddit
URL4=https://reddit.com


#**********************#
#** BOT HEALTH CHECK **#
#**********************#
# The bot serves GET /healthz on this host/port inside its own container,
# used by the discord-bot healthcheck in the compose files. It reports 503
# until the Discord gateway connects, and after that it reports on both
# loops that reconcile roles: "star_check" for the periodic sweep and
# "role_sync" for the webhook drain. Each is disabled, pending, ok or stale,
# a loop you turned off reads disabled and can never be late, and either one
# going stale makes the whole response degraded with 503. A webhook-only
# deployment (AUTOMATIC_CHECK=false, ROLE_SYNC_ENABLED=true) is therefore
# still measured, by the drain.
# Leave this on if you use the compose healthcheck: turning it off stops the
# endpoint being served at all, so that healthcheck then fails forever and
# the container sits permanently marked unhealthy even though the bot itself
# is fine. If you do turn it off, remove the healthcheck from compose too.
# BOT_HEALTH_PORT must be a TCP port between 1 and 65535; a value outside
# that range is refused by name at startup.
BOT_HEALTH_ENABLED=true
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=8080


#******************#
#** GITHUB OAUTH **#
#******************#

# The target user/repo for the bot functions
REPO_OWNER=
GITHUB_REPO=

# SERVER
# SERVER_PORT is the port published on the host machine. SERVER_BIND_PORT is
# the port the application listens on inside the container; leave it at 5000
# unless something else in your setup already uses that port internally,
# since the compose port mapping tracks it automatically either way. It must
# be a TCP port between 1 and 65535: anything else is refused by name at
# startup rather than clamped, because a clamped port is a different address.
# DOMAIN must be the public HTTPS address of the OAuth server, with no query
# string or fragment; users are sent there from Discord, so it has to be
# reachable from outside your network. The server validates this at startup
# and refuses to start on anything else, including a plain http:// URL.
SERVER_PORT=5000
SERVER_BIND_PORT=5000
DOMAIN=https://example.com

# GitHub OAuth app: https://github.com/settings/developers
# Set the callback to `https://your-domain/authorize` in the GitHub settings.
# The app only requests the `read:user` scope.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub personal access token, used only to list the repository's stargazers.
# OPTIONAL for a public repo, but without it GitHub allows just 60 requests per
# hour, which is not enough beyond a few thousand stargazers.
# No scopes are needed for a public repo; `public_repo` is enough.
# A private repo cannot be made to work by granting this more: the star check
# in the OAuth flow uses the member's own token, which only has `read:user`
# and cannot see a private repo, so everyone is recorded as not having
# starred. Point Starguard at a public repository.
GITHUB_TOKEN=

# REQUIRED. Signs session cookies and the personal verification links handed
# out by /verify, so it must be unguessable and identical for the bot and the
# server. The application refuses to start on a placeholder or short value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# OPTIONAL. The shared secret for the GitHub `star` webhook. With it set, the
# server learns about a star the moment it happens instead of waiting for the
# next sweep, and the bot moves the role within ROLE_SYNC_INTERVAL seconds.
# Paste the same value into the webhook's "Secret" field on GitHub.
# Leave it empty and the receiver is not registered at all: there is then no
# /webhooks/github route, and the sweep above is the only thing that notices
# a star changing. Validated exactly like SECRET_KEY: placeholder values and
# anything shorter than 16 characters are rejected at startup.
# This is a different secret from SECRET_KEY; generate a second one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Treat it as a credential: it is the only thing authenticating a delivery,
# so anybody holding it can sign a star event for any GitHub account and the
# server will act on it. Redact it before pasting logs or config anywhere.
# Full setup is Step 12 of docs/installation.md.
GITHUB_WEBHOOK_SECRET=

# How long a /verify link stays usable, in seconds (minimum 60).
LINK_TOKEN_MAX_AGE=900

# How many reverse proxies sit directly in front of the server, used both to
# rebuild the OAuth redirect as https:// behind TLS termination and to pick
# the real client address the rate limiter below keys on. Count only proxies
# you control: with docker-compose.alt.yml's bundled Nginx Proxy Manager and
# nothing else in front of it, that is 1; add one more for every additional
# hop you operate, such as a CDN or a load balancer, in front of that.
# Too low, and every client behind your own proxy collapses onto that
# proxy's address for rate-limiting purposes. Too high, and a client can
# prepend forged entries to X-Forwarded-For that reach past your proxies,
# spoofing whatever address it likes and defeating the rate limit.
# Set it to 0 when nothing sits in front and the published port is your
# front door: the forwarded headers are then not read at all, which is the
# only safe reading of a header anybody who can reach the port can send.
TRUSTED_PROXY_COUNT=1

# Per-IP rate limit on /login and /authorize: this many requests within the
# window (in seconds). Held in memory by the single server process, so it
# resets on restart and is per-instance if you ever run more than one.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW=60


#**********************#
#** MONGODB DATABASE **#
#**********************#
# MONGO_HOST examples:
#   mongodb://<user>:<password>@mongodb:27017/?authSource=admin
#        <- the bundled container (see override.example.yml). It now requires
#           authentication, so fill in the same credentials you set for
#           MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD below.
#   mongodb://127.0.0.1:27017/      <- a MongoDB running on the host
#   mongodb+srv://user:pass@cluster.example.mongodb.net/   <- Atlas
# The username and password segments of this URI are parsed by pymongo, so
# a reserved character in either must be percent-encoded. Measured against
# the pinned pymongo, through MongoClient, which is what the bot and the
# server actually call:
#   @ : / %   raise a caught error. The process still starts and /healthz
#             reports the database unavailable.
#   ?         raises an uncaught error and the process exits outright, so
#             there is no 503 to look at, only a restart loop. A mistyped
#             port does the same thing, for the same reason: both end up
#             putting something non-numeric where the port belongs.
#   +         is the worst of them, because nothing complains at all. It is
#             silently decoded to a space, so the password is quietly wrong
#             while MongoDB, its healthcheck and Mongo Express all take the
#             literal value and keep working. The database looks healthy and
#             only the two processes that parse a URI cannot sign in.
#   # [ ] ! $ need no encoding.
# Generating both values with the command below sidesteps all of it, since
# token_urlsafe only ever emits A-Z a-z 0-9 - and _. If you set them by hand
# instead, percent-encode with:
#   python -c "from urllib.parse import quote; print(quote('<value>', safe=''))"
MONGO_HOST=mongodb://<MONGO_INITDB_ROOT_USERNAME>:<MONGO_INITDB_ROOT_PASSWORD>@mongodb:27017/?authSource=admin
MONGO_DATABASE=starguard

# Only used by override.example.yml / docker-compose.alt.yml. The bundled
# MongoDB creates this as its root user on first launch and requires it for
# every connection from then on, including from the bot and the server, so
# it must match the credentials you put in MONGO_HOST above. Both compose
# files refuse to start the database without these set.
# Generate values that need no percent-encoding with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=


#*******************#
#** MONGO-EXPRESS **#
#*******************#
# Only used by override.example.yml / docker-compose.alt.yml. Uncomment the
# two credentials below and fill them in if you use either file: Compose
# checks them before it starts anything, so leaving them unset stops the
# whole stack, not just the admin UI. The UI is published on the loopback
# interface only; reach it over an SSH tunnel.

# MONGO_EXPRESS_USERNAME=
# MONGO_EXPRESS_PASSWORD=
# MONGO_EXPRESS_PORT=8081


#*******************************#
#** NGINX PROXY MANAGER (NPM) **#
#*******************************#
# Only used by docker-compose.alt.yml. Without these, NPM falls back to its
# well-known default login (admin@example.com / changeme) until someone signs
# in and changes it, which on a public HTTP/HTTPS listener is a real window.
# Setting them seeds the initial admin account instead.

# NPM_INITIAL_ADMIN_EMAIL=
# NPM_INITIAL_ADMIN_PASSWORD=


#*************#
#** LOGGING **#
#*************#
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# text or json. json is easier to feed into a log aggregator.
LOG_FORMAT=text
