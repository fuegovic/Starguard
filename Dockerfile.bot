# python:3.12-slim, digest resolved 2026-09-19. Multi-stage: the builder
# stage installs into a virtualenv so pip, its download cache and any build
# metadata never reach the runtime layer below. None of the pinned
# dependencies need a compiler, so the final stage stays on the same slim
# base rather than moving to a distroless image, which keeps useradd and a
# shell available for operators debugging a running container.
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9 AS builder

WORKDIR /app

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Dependencies first so code changes do not invalidate the install layer.
# requirements.lock is the hash-pinned, fully resolved closure generated from
# requirements.txt (see CONTRIBUTING.md); --require-hashes makes pip refuse
# to install anything whose hash does not match, so a compromised package
# index or a tampered wheel fails the build instead of shipping.
COPY requirements.lock ./
# pip uninstalls itself as the last step so the venv copied into the runtime
# layer below holds only the installed dependencies, not the installer, its
# metadata or setuptools/wheel (present only on interpreters where ensurepip
# still bundles them); pip removing its own files works because the running
# process has already read what it needs to finish the command.
RUN pip install --no-cache-dir --upgrade pip==26.2.1 \
    && pip install --no-cache-dir --require-hashes -r requirements.lock \
    && pip uninstall -y pip setuptools wheel

FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9

LABEL org.opencontainers.image.source="https://github.com/fuegovic/Starguard" \
      org.opencontainers.image.description="Starguard Discord bot: GitHub star verification and role assignment." \
      org.opencontainers.image.licenses="MIT"

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

COPY --from=builder /opt/venv /opt/venv
COPY common/ ./common/
COPY bot/ ./bot/

# The configuration is supplied at run time via env_file; baking .env.example
# into the image shipped a publicly known SECRET_KEY.
RUN useradd --create-home --uid 10001 starguard
USER starguard

# The healthcheck (GET /healthz on BOT_HEALTH_HOST:BOT_HEALTH_PORT, served by
# bot/health.py) is defined in the compose files rather than here, matching
# Dockerfile.server.

CMD ["python", "-m", "bot.bot"]
